# Hostinger Web Server Configuration (.htaccess)
# Bapperida Provinsi Papua Selatan

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to uploaded media and static files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct execution of Hostinger PHP upload & data handlers
  RewriteRule ^api-hostinger/(.*)$ api-hostinger/$1 [L]
  RewriteRule ^api/upload/?$ api-hostinger/upload.php [QSA,L]
  RewriteRule ^api/storage/info/?$ api-hostinger/upload.php [QSA,L]
  RewriteRule ^api/data/(.*)$ api-hostinger/data.php?key=$1 [QSA,L]
  RewriteRule ^api/data/?$ api-hostinger/data.php [QSA,L]
  RewriteRule ^api/sync/all/?$ api-hostinger/data.php?all=true [QSA,L]

  # Route all other URLs to SPA index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Increase upload and post limits on Apache / PHP / LiteSpeed
<IfModule mod_php7.c>
  php_value upload_max_filesize 128M
  php_value post_max_size 128M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 128M
  php_value post_max_size 128M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule litespeed>
  php_value upload_max_filesize 128M
  php_value post_max_size 128M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache headers for uploaded media and assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
